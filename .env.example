# Copy to .env and fill in. .env is gitignored.
#
# These are read by the functions in api/ — the server side of the web
# subscription. None of them is prefixed VITE_, so Vite cannot inline any of
# them into the browser bundle. The App Store / Google Play builds need none
# of this: those are billed by the store, in yuan, on the store's own terms.

# Creem — test keys start with creem_test_, live keys with creem_live_.
# The key decides which catalogue is used: a test key talks to the sandbox.
CREEM_API_KEY=

# The two products 「Slides 天才」 is sold as on the web, from the Creem
# dashboard. US$1.99/month and US$4.99/year. Until both are set, the web
# paywall reports that the subscription is not on sale yet.
CREEM_PRODUCT_MONTHLY=
CREEM_PRODUCT_YEARLY=

# ── Shared state: multiplayer rooms, and the accounts a redeemed code
# creates. Redis over REST — Vercel KV or Upstash, same protocol. Without
# these, rooms and redeem codes report that they are not open yet; card
# subscriptions are unaffected, since those are read from Creem directly.
#
# 名字是 KV_* 而**库可以是 Upstash**：两家说的是同一套 REST 协议。Upstash 控制台里那
# 两行叫 UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN，`api/_store.js` 把它们当
# **后备**也认（KV_* 在前，缺了才看 UPSTASH_*），所以两套名字填哪一套都行。
#
# 要紧的是**不要两套都填、还填得不一样**：那时生效的是 KV_* 那一对，而人会去改另一
# 对然后纳闷为什么没反应。只填一套。
#
# ⚠️ 从控制台复制 URL 时**带上 https://**，而且末尾不要留斜杠。少了协议头那一次请求
# 连不上，而 `storeConfigured()` 只看「这两个有没有值」——于是小屋和兑换码会一路报
# 500，屏幕上却不是那句诚实的「这个功能还没开」。
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 后备的那一对名字（Upstash 控制台直接给的就是这两个）。填了上面那对就不用管这里。
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── 发信（Resend）。这个应用只寄一种信：六位验证码——登录 / 注册（api/signin.js），和换邮箱、
# 绑定邮箱（api/email.js，寄到新地址）。从前写在这儿的「连错六次之后的解锁码」那条路第 20 推起撤了
# （代码在 api/_unlock_legacy.js）。
#
# **两个都要填**：mailConfigured() 两个都在才算数——只填了密钥、漏了 MAIL_FROM，等于没配（踩过一次）。
# 没配的时候不假装寄出去了：登录那一屏说「邮件暂时寄不出」，引他走免邮箱那条路；换邮箱 / 绑定邮箱
# 那扇窗说「目前还无法自动发信」，请他写信到支持邮箱。
RESEND_API_KEY=
MAIL_FROM=

# ── 发码与维护用的管理员令牌（api/mint.js 批量发内部码、api/scores.js 的
# 榜单维护都认它）。**至少 32 个随机字符**——这一把钥匙背后是「无限发码」和
# 「导出全部玩家邮箱」，短了就是把门虚掩着。生成一个：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# 接口本身按来源限速（一小时 20 次，见 api/_ratelimit.js），但那只是拖慢猜的
# 人，真正说了算的还是这串够不够长。
ADMIN_TOKEN=

# ── 授予开关：登录即送终身天才（E11 / PR-12）。**只有值正好是 1 才算开**
# （api/_entitlement.js 的 grantWindowOpen），别的值、空着、压根没这一行，都是关。
#
# 默认是「关」，而且**不许改成「没配就当开」**：那种默认会让任何一份忘了配环境变量
# 的部署悄悄把终身权益送出去，而已经送出去的不回收。
#
# ⚠️⚠️ **关掉它会让界面上那句话变成假话。**《Slides 天才》那一屏写的是「注册后免费
# 立即解锁全部内容」，而那句话写死在 i18n 里、不再问服务端。所以这儿一关，玩家照着
# 那句话去登录，登得进、却不是天才，**屏幕上什么都不报**。要关它，必须先把那句话改
# 回中性文案。它是回退开关，不是日常可调的旋钮。
GENIUS_GRANT_WINDOW=1
