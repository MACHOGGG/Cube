node_modules
dist
dist-artifact
dist-ssr
*.local
.DS_Store
*.tsbuildinfo

# Capacitor / native
android/app/build
android/.gradle
android/local.properties
ios/App/Pods
ios/App/build

# Secrets — API keys live here and never in the repo
.env
.env.*
!.env.example

# 设计画布与图标清单：由 scripts/ui-snapshot.mjs 和 scripts/icon-sheet.mjs
# 从代码里重新生成，不是源文件。
design/
slides-interface.html
slides-icons.zip

# 界面模拟器：由 scripts/ui-screens.mjs + build-simulator.mjs 生成，不是源文件。
slides-simulator.html

# 小工具预览页：由 node xhs/preview.mjs 生成，不是源文件。
xhs/preview.html
.tmp-oldcss/

# 开场动画导出的产物：源在 tools/splash/，产物随时能重出
#   npm run build:splash        → splash.html
#   node tools/splash/record.mjs → splash-<边长>.webm
# 都是一两百 KB 到几百 KB 的二进制，进版本库只会一次比一次旧。
tools/splash/splash.html
tools/splash/*.webm
tools/splash/frames-*
tools/splash/.video
